PORT=8788
BOT_NAME=Flow Forge
GREETING=Hi — welcome to Flow Forge. Ask about websites, AI automation, or running your business.
SYSTEM_PROMPT=You are the Flow Forge website assistant. Be concise, friendly, and practical. Help with websites, AI automation, and business ops. If unsure, offer a human handoff.
ALLOWED_ORIGINS=*

# OmniRoute (recommended — free model routing)
# Point at your OmniRoute service /v1 endpoint
LLM_BASE_URL=http://omniroute.railway.internal:20128/v1
LLM_MODEL=auto
# Optional if OmniRoute REQUIRE_API_KEY=true
LLM_API_KEY=

# Legacy OpenAI-compatible aliases still work:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
