PORT=8788
BOT_NAME=Flow Forge
GREETING=Hi — welcome to Flow Forge. Ask about websites, AI automation, or running your business.
SYSTEM_PROMPT=You are the Flow Forge website assistant. Be concise, friendly, and practical. Help with websites, AI automation, and business ops. If unsure, offer a human handoff.
ALLOWED_ORIGINS=*

# OmniRoute free-model routing
LLM_BASE_URL=https://omniroute-production-fa75.up.railway.app/v1
LLM_MODEL=auto/best-free
# Optional override of fallback chain (comma-separated). Empty = built-in free chain + discovered free models
# LLM_FALLBACKS=auto/best-free,auto/coding:free,auto/cheap,auto/fast,auto/chat
LLM_API_KEY=
